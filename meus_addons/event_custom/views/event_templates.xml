<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="registration_template_inherit_groups" inherit_id="website_event.registration_template">
        
        <xpath expr="//button[@data-bs-target='#modal_ticket_registration']" position="attributes">
            <attribute name="t-if">event.event_registrations_open and event.is_user_allowed</attribute>
        </xpath>

        <xpath expr="//button[@data-bs-target='#modal_ticket_registration']" position="after">
            <t t-if="not event.is_user_allowed">
                <div class="alert alert-info mt-3">
                    <i class="fa fa-lock me-2"/>
                    Este evento é exclusivo para membros do grupo 
                    <strong><t t-esc="event.allowed_group_id.name"/></strong>.
                </div>
            </t>
        </xpath>

    </template>
</odoo>